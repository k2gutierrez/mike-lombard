# =============================================================================
# Mike Lombard — portfolio · environment
# =============================================================================
# Copy to `.env.local` (gitignored) and fill in. Never commit real keys.
# Audit what is configured with:  npm run check:backend
# =============================================================================

# --- Public (shipped to the browser; protected by RLS) -----------------------
# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → publishable (or the legacy "anon")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origin without a trailing slash. Used for the sign-in redirect and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Exact same origin, server-side. Set the real HTTPS origin in production.
APP_ORIGIN=http://localhost:3000

# --- Secret (server only: never prefix with NEXT_PUBLIC_) --------------------
# Supabase → Project Settings → API Keys → service_role.
# ⚠️ Bypasses RLS. Used only by the admin API routes to validate uploads,
# publish content and read mint registrations.
SUPABASE_SERVICE_ROLE_KEY=

# --- Setup / onboarding ------------------------------------------------------
# Comma-separated. Any account with one of these emails is promoted to
# administrator on first sign-in and by `npm run db:apply`. Remove it once the
# role row exists, if you prefer the database to be the only source of truth.
ML_ADMIN_EMAILS=

# "email"  → Supabase sends a magic link (needs SMTP configured).
# anything else → the server signs the allowlisted admin in directly with a
# one-time token, so the panel works before SMTP exists. Recommended default.
ML_AUTH_MODE=handoff

# Salt for hashing IPs and emails in the rate limiter and the registrations
# table. Change it to a random string; rotating it only resets throttle buckets.
ML_HASH_SALT=change-me-to-a-random-string

# Only needed by `npm run db:apply` (Supabase Management API). Revoke after use.
# SUPABASE_ACCESS_TOKEN=

# --- Optional -----------------------------------------------------------------
# Wallet connection on /mint. Without it the form still accepts a pasted address
# and no wallet code is loaded at all.
# Reown/WalletConnect project id (https://cloud.reown.com). The Mingles project
# already has one; reuse it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Dedicated ApeChain RPC. Optional: the public endpoint is the fallback.
# APECHAIN_RPC_URL=https://rpc.apechain.com/http

# 1 = ask Supabase Storage for resized derivatives (paid Image Transformations).
# 0 or unset = let the Next.js image optimizer resize the originals.
NEXT_PUBLIC_ML_IMAGE_TRANSFORMS=0

# Namespacing inside the shared Mingles Supabase project. Leave the defaults.
# ML_SITE_ID=mike-lombard
# ML_MEDIA_BUCKET=ml-media
# ML_MEDIA_PREFIX=mike-lombard
